{
  "name": "ark-code-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ark Code mode renderer (design §7.10.2). Talks to arkd over local HTTP + SSE only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5273 --strictPort",
